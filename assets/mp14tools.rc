// Resource script for the Windows executable.
//
// One icon and one version block. `assets/mp14tools.ico` is generated from the
// same design as the tray and window icons by `tools/make-icon.ps1`; see
// `src/icon.rs` for the numbers behind it.
//
// The version block is not written here: `build.rs` generates it from the
// package version in `Cargo.toml` into the build directory and adds that
// directory to the include path, so bumping the version in `Cargo.toml` is
// enough. Compile this file through `build.rs`, which is what puts both include
// directories in place.

#include <winver.h>

1 ICON "mp14tools.ico"

#include "mp14tools_version.rc"
