// Resource script for the Windows executable.
//
// One icon and one version block. `assets/mp14tools.ico` is generated from the
// same design as the tray and window icons by `tools/make-icon.ps1`; see
// `src/icon.rs` for the numbers behind it.
//
// `build.rs` compiles this file with windres when it is available and links the
// result, so the icon and the version block reach Explorer's file properties.

#include <winver.h>

1 ICON "mp14tools.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,2,5,0
PRODUCTVERSION  0,2,5,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "MP14Tools\0"
            VALUE "FileVersion",     "0.2.5.0\0"
            VALUE "InternalName",    "mp14tools\0"
            VALUE "OriginalFilename","mp14tools.exe\0"
            VALUE "ProductName",     "MP14Tools\0"
            VALUE "ProductVersion",  "0.2.5.0\0"
            VALUE "Comments",        "Touchpad deep-press and OEM key remapper\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
